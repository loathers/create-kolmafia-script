{
  "name": "create-kolmafia-script",
  "description": "Create a kolmafia script with ease",
  "version": "0.4.0",
  "author": "Sam Gaus <sam@gaus.co.uk>",
  "scripts": {
    "build": "tsc --noEmit && tsup src/cli.ts --minify --format esm",
    "clean": "shx rm -rf dist",
    "dev": "tsup src/cli.ts --watch",
    "prepack": "npm run clean && npm run build",
    "format": "eslint src --fix --ext .ts && prettier --write --list-different .",
    "lint": "eslint src --ext .ts && prettier --check .",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loathers/create-kolmafia-script.git"
  },
  "type": "module",
  "bin": "dist/cli.js",
  "files": [
    "dist",
    "template"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.3.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.8.1",
    "shx": "^0.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^5.6.2",
    "change-case": "^5.4.4",
    "execa": "^9.6.1",
    "handlebars": "^4.7.8",
    "pargs": "^1.4.2",
    "spdx-license-list": "^6.11.0"
  },
  "packageManager": "yarn@4.6.0",
  "engines": {
    "node": "^22.20 || ^24.10 || >= 25"
  },
  "engineStrict": true
}
